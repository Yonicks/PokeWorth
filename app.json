{
  "expo": {
    "name": "PokeWorth",
    "slug": "pokeworth",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pokeworth",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.pokeworth.app",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#031229",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pokeworth.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "PokeWorth uses the camera to photograph Pokémon cards for identification."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PokeWorth uses your photos to identify Pokémon cards.",
          "cameraPermission": "PokeWorth uses the camera to photograph Pokémon cards for identification.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#031229",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "./plugins/with-short-cxx-dir",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "7359c7f3-213e-4792-aabf-255b13a6a0d0"
      }
    },
    "owner": "yonicks",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7359c7f3-213e-4792-aabf-255b13a6a0d0"
    }
  }
}
